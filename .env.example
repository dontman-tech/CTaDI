# ---------------------------------------------------------------------------
# CTaDI onboarding — environment variables.
# Copy to .env for local development, and set the same keys in the Vercel
# dashboard (Settings -> Environment Variables) for deployments.
# NEVER commit .env. No key is ever hard-coded.
# ---------------------------------------------------------------------------

# --- Public base URL of this service (used to build approve/reject links) ---
# Local: http://localhost:3000. On Vercel: your production URL, e.g.
# https://ctadi.vercel.app — if this is wrong, the approve/reject links in the
# admin email point at the wrong place.
PUBLIC_BASE_URL=http://localhost:3000

# --- Admin + sender identity -------------------------------------------------
ADMIN_EMAIL=you@example.org
# Must be a domain you have verified with your email provider.
FROM_EMAIL=CTaDI Onboarding <onboarding@your-domain.org>
# console | resend | brevo | gmail
# Use "console" locally to print emails to stdout instead of sending them.
EMAIL_DRIVER=console

# --- Email provider (pick ONE driver; all have free tiers) -------------------
# driver=resend  -> https://resend.com        (3,000 emails/month free)
RESEND_API_KEY=
# driver=brevo   -> https://brevo.com         (300 emails/day free)
BREVO_API_KEY=
# driver=gmail   -> Gmail app password over SMTP (free). Avoid on serverless:
# some hosts block outbound SMTP ports. Resend or Brevo is preferred there.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Screening is manual ----------------------------------------------------
# There is no LLM and no API key to set. Every submission is emailed to
# ADMIN_EMAIL with one-click Approve / Reject links.

# Hard cap on applicant answer length, in characters, per answer.
MAX_ANSWER_CHARS=6000

# --- Storage ----------------------------------------------------------------
# sqlite | json | supabase
# On Vercel this defaults to supabase (serverless disks do not persist).
# Locally it defaults to json, so you can start with no configuration at all.
STORAGE_DRIVER=
SQLITE_PATH=./data/ctadi.sqlite
JSON_DB_PATH=./data/ctadi.json
# Required when STORAGE_DRIVER=supabase (or on Vercel).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Security ---------------------------------------------------------------
# Secret used to sign one-click approve/reject links. REQUIRED in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APPROVAL_TOKEN_SECRET=
# How long an approve/reject link stays valid (336 hours = 14 days).
APPROVAL_TOKEN_TTL_HOURS=336
# Protects /api/admin/applications. If unset, that route is open — set it.
ADMIN_API_TOKEN=
# --- Portal ----------------------------------------------------------------
# Where the community link points (shown to approved applicants).
COMMUNITY_INVITE_URL=https://community.example.org/join/ctadi
# Optional: if true, approved applicants are also emailed the link directly.
EMAIL_APPLICANT_ON_APPROVAL=false

# --- Rate limiting ----------------------------------------------------------
# Per-IP submissions per hour.
SUBMIT_RATE_LIMIT_PER_HOUR=5
# On serverless the in-process limiter is per-instance, so a distributed
# backend is recommended. Set RATE_LIMIT_BACKEND=upstash (free tier) or
# =supabase (needs the ctadi_rate_limit function — see README).
RATE_LIMIT_BACKEND=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
