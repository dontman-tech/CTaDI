# ---------------------------------------------------------------------------
# CTaDI onboarding — environment variables.
# Copy to .env and fill in. NEVER commit .env. No key is ever hard-coded.
# ---------------------------------------------------------------------------

# --- Public base URL of this service (used to build approve/reject links) ---
PUBLIC_BASE_URL=http://localhost:3000

# --- Admin + sender identity -------------------------------------------------
ADMIN_EMAIL=you@example.org
FROM_EMAIL=CTaDI Onboarding <onboarding@example.org>
# Set to "console" to print emails to stdout instead of sending (great for dev).
EMAIL_DRIVER=console

# --- Email provider (pick ONE driver; all have free tiers) -------------------
# driver=resend  -> https://resend.com        (3,000 emails/month free)
RESEND_API_KEY=
# driver=brevo   -> https://brevo.com         (300 emails/day free)
BREVO_API_KEY=
# driver=gmail   -> Gmail API / SMTP app password (free, ~500/day)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- LLM providers (free tiers). Order here = failover order. ---------------
# Primary: Google Gemini (AI Studio free tier). Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Fallback 1: Groq (free plan: 30 RPM / 1,000 RPD per model)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Fallback 2: OpenRouter free models (":" suffixed ids). Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Optional: any OpenAI-compatible endpoint (Together, Cerebras, Ollama, vLLM...)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# --- Scoring knobs ----------------------------------------------------------
# 0 = deterministic, no sampling. Do not change unless you know why.
LLM_TEMPERATURE=0
# Retries per provider on malformed JSON / 5xx / timeout (then failover).
LLM_MAX_RETRIES=1
LLM_TIMEOUT_MS=45000
# Hard cap on applicant answer length, in characters, per answer.
MAX_ANSWER_CHARS=6000

# --- Storage ----------------------------------------------------------------
# sqlite (default, zero-setup) | json | supabase
STORAGE_DRIVER=sqlite
SQLITE_PATH=./data/ctadi.sqlite
JSON_DB_PATH=./data/ctadi.json
# If STORAGE_DRIVER=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Security ---------------------------------------------------------------
# Secret used to sign one-click approve/reject links. REQUIRED in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APPROVAL_TOKEN_SECRET=
# How long an approve/reject link stays valid.
APPROVAL_TOKEN_TTL_HOURS=336

# --- Portal ----------------------------------------------------------------
# Where the community link points (shown to approved applicants).
COMMUNITY_INVITE_URL=https://community.example.org/join/ctadi
# Optional: if set, approved applicants are also emailed the link directly.
EMAIL_APPLICANT_ON_APPROVAL=false

# --- Rate limiting (basic, in-process) -------------------------------------
SUBMIT_RATE_LIMIT_PER_HOUR=5
