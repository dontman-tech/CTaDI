# ---------------------------------------------------------------------------
# CTaDI onboarding — environment variables.
# Copy to .env for local development, and set the same keys in the Vercel
# dashboard (Settings -> Environment Variables) for deployments.
# NEVER commit .env. No key is ever hard-coded.
# ---------------------------------------------------------------------------
# There is no email provider and no LLM: applications are reviewed by hand in
# the admin dashboard at /admin.

# --- Public base URL of this service ---------------------------------------
# Local: http://localhost:3000. On Vercel: your production URL.
PUBLIC_BASE_URL=http://localhost:3000

# --- Storage ----------------------------------------------------------------
# postgres | sqlite | json
# On Vercel this defaults to postgres (a serverless disk does not persist).
# Locally it defaults to json, so you can start with no configuration at all.
STORAGE_DRIVER=
# Required for the postgres driver, and set automatically on Vercel when you
# add a Postgres integration from the Marketplace (Neon).
DATABASE_URL=
# Used only by the sqlite driver.
SQLITE_PATH=./data/ctadi.sqlite
# Used only by the json driver.
JSON_DB_PATH=./data/ctadi.json

# --- Admin dashboard --------------------------------------------------------
# This token is the MASTER admin. It always exists, cannot be deleted, and is
# the only account that can create and delete the other admins.
#
# Protects /admin and every /api/admin/* route. REQUIRED in production:
# without it the dashboard refuses to serve. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
#
# Other admins are created from the dashboard itself; their tokens are stored
# only as hashes in the database, never here.
ADMIN_API_TOKEN=

# --- Portal -----------------------------------------------------------------
# Where the community link points (shown to approved applicants).
COMMUNITY_INVITE_URL=https://community.example.org/join/ctadi

# --- Rate limiting ----------------------------------------------------------
# Per-IP submissions per hour. On Vercel the counter lives in Postgres, so it
# is shared across every function instance.
SUBMIT_RATE_LIMIT_PER_HOUR=5
# Hard cap on applicant answer length, in characters, per answer.
MAX_ANSWER_CHARS=6000
